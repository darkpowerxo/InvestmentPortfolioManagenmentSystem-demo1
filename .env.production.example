# Production Environment Variables
# Copy this file to .env.production for production deployment

# Database Configuration
SQL_SA_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
CONNECTION_STRING=Server=sqlserver,1433;Database=InvestmentPortfolioManager;User Id=sa;Password=CHANGE_THIS_STRONG_PASSWORD_123!;TrustServerCertificate=true;MultipleActiveResultSets=true

# Redis Configuration  
REDIS_CONNECTION_STRING=redis:6379,password=CHANGE_THIS_REDIS_PASSWORD_123!

# JWT Configuration
JWT_SECRET_KEY=CHANGE_THIS_SUPER_SECRET_JWT_KEY_FOR_PRODUCTION_USE_MINIMUM_32_CHARS
JWT_ISSUER=InvestmentPortfolioManager.CDPQ
JWT_AUDIENCE=CDPQ.Production
JWT_EXPIRY_MINUTES=30

# File Storage
REPORTS_PATH=/app/reports
EXPORTS_PATH=/app/exports

# Logging
LOG_LEVEL=Warning

# Monitoring
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD_123!

# API Configuration
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# SSL Configuration
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/certificate.crt
SSL_PRIVATE_KEY_PATH=/etc/nginx/ssl/private.key