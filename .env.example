# Development Environment Variables
# Copy this file to .env.development for local development

# Database Configuration
SQL_SA_PASSWORD=Portfolio123!
CONNECTION_STRING=Server=sqlserver,1433;Database=InvestmentPortfolioManager;User Id=sa;Password=Portfolio123!;TrustServerCertificate=true;MultipleActiveResultSets=true

# Redis Configuration
REDIS_CONNECTION_STRING=redis:6379,password=RedisPortfolio123!

# JWT Configuration
JWT_SECRET_KEY=SuperSecretKeyForJWTTokenGeneration123456789DEVELOPMENT
JWT_ISSUER=InvestmentPortfolioManager
JWT_AUDIENCE=CDPQ
JWT_EXPIRY_MINUTES=60

# File Storage
REPORTS_PATH=/app/reports
EXPORTS_PATH=/app/exports

# Logging
LOG_LEVEL=Information

# API Configuration
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8080/api
FRONTEND_PORT=3000

# Database Ports
SQL_SERVER_PORT=1433
REDIS_PORT=6379